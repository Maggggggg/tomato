<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>🍅 Tomato Mutations</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>

*{
 box-sizing:border-box;
 -webkit-tap-highlight-color:transparent
}

body{
 margin:0;
 font-family:Arial,sans-serif;
 color:white;
 background:radial-gradient(circle at top,#263b4d,#090e13 70%);
 min-height:100vh
}

button{
 border:0;
 border-radius:14px;
 padding:13px 18px;
 font-size:17px;
 font-weight:bold;
 color:white;
 cursor:pointer;
 touch-action:manipulation;
 box-shadow:0 5px 0 #0005
}

button:active{
 transform:translateY(4px);
 box-shadow:0 1px 0 #0005
}

header{
 text-align:center;
 padding:15px 10px 5px
}

h1{
 margin:0;
 font-size:30px
}

.subtitle{
 color:#aeb9c5;
 margin-top:5px
}

.game{
 width:min(1000px,94%);
 margin:auto
}

.stats{
 display:flex;
 justify-content:center;
 gap:8px;
 flex-wrap:wrap;
 margin:12px 0
}

.stat{
 background:#192530;
 border:1px solid #344858;
 border-radius:12px;
 padding:9px 15px;
 min-width:105px;
 text-align:center
}

.field{
 position:relative;
 min-height:360px;
 border:4px solid #17301a;
 border-radius:24px;
 overflow:hidden;
 background:
 radial-gradient(circle at 15% 20%,#477e3e 0 3%,transparent 3.5%),
 radial-gradient(circle at 80% 70%,#477e3e 0 3%,transparent 3.5%),
 linear-gradient(#438341,#27602c);
 display:flex;
 flex-direction:column;
 justify-content:center;
 align-items:center
}

/* FRUIT */

.fruit{
 position:relative;
 width:150px;
 height:150px;
 border-radius:50%;
 background:radial-gradient(circle at 35% 28%,#ff8a8a,#ed343b 48%,#b71620);
 border:3px solid #9e1820;
 box-shadow:
 inset -13px -16px 18px #760c1633,
 0 12px 22px #0006;
 transition:.35s;
 animation:float 1.5s infinite alternate ease-in-out
}

@keyframes float{
 from{transform:translateY(0)}
 to{transform:translateY(-6px)}
}

.faceEye{
 position:absolute;
 top:52px;
 width:20px;
 height:24px;
 background:white;
 border:2px solid #252525;
 border-radius:50%
}

.faceEye:after{
 content:"";
 position:absolute;
 width:8px;
 height:11px;
 background:#222;
 border-radius:50%;
 left:4px;
 top:5px
}

.faceEye.left{left:38px}
.faceEye.right{right:38px}

.mouth{
 position:absolute;
 left:50%;
 bottom:34px;
 transform:translateX(-50%);
 width:45px;
 height:20px;
 border-bottom:5px solid #301414;
 border-radius:0 0 45px 45px
}

.cheek{
 position:absolute;
 top:79px;
 width:22px;
 height:10px;
 background:#ff8b8b77;
 border-radius:50%
}

.cheek.left{left:17px}
.cheek.right{right:17px}

.stem{
 position:absolute;
 top:-20px;
 left:50%;
 width:9px;
 height:28px;
 background:#704321;
 border-radius:8px;
 transform:translateX(-50%) rotate(8deg)
}

.leaf{
 position:absolute;
 top:-18px;
 left:50%;
 width:32px;
 height:17px;
 background:#4ba54c;
 border-radius:100% 0 100% 0;
 transform:translateX(-75%) rotate(-20deg)
}

.leaf.r{
 transform:translateX(-5%) rotate(20deg);
 border-radius:0 100% 0 100%
}

/* CAROTTE */

.fruit.carrot{
 width:85px;
 height:210px;
 border-radius:48% 48% 58% 58%;
 background:linear-gradient(150deg,#ffc45a,#f36a19 60%,#c7440c);
 border:3px solid #a83c0b
}

.fruit.carrot .stem{
 height:25px;
 background:#438c39
}

.fruit.carrot .leaf{
 background:#49a544
}

/* MUTATIONS */

.fruit.golden{
 box-shadow:0 0 38px #ffd83d99,inset -13px -16px 18px #8d610033
}

.fruit.green{
 background:radial-gradient(circle at 35% 28%,#b4ff9e,#49b94e 55%,#207b29)
}

.fruit.blue{
 background:radial-gradient(circle,#b3f4ff,#3d9bea 55%,#1554a5)
}

.fruit.rainbow{
 background:conic-gradient(#f44,#fc4,#5d5,#4cf,#75f,#f5c,#f44)
}

.fruit.fire{
 background:radial-gradient(circle,#fff38a,#ff7b1e 50%,#b81818);
 box-shadow:0 0 38px #ff6b1a
}

.fruit.ice{
 background:radial-gradient(circle,#fff,#71e6ff 55%,#2778e8);
 box-shadow:0 0 30px #65ddff
}

.fruit.rotten{
 background:radial-gradient(circle,#a98952,#55401f 60%,#292015);
 filter:saturate(.55)
}

/* BANANE */

.fruit.bananaCostume{
 background:#ffd92f;
 border-color:#c99c00;
 box-shadow:
 0 0 30px #ffe44d99,
 inset -12px -12px 15px #b9870033
}

.bananaPeel{
 position:absolute;
 width:45px;
 height:95px;
 background:linear-gradient(90deg,#fff06b,#e5b900);
 border:3px solid #b28b00;
 border-radius:50% 50% 35% 35%;
 z-index:2
}

.bananaPeel.p1{
 left:-27px;
 bottom:-12px;
 transform:rotate(25deg)
}

.bananaPeel.p2{
 right:-27px;
 bottom:-12px;
 transform:rotate(-25deg)
}

.bananaPeel.p3{
 left:50%;
 bottom:-35px;
 transform:translateX(-50%);
 height:105px
}

.bananaTop{
 position:absolute;
 top:-18px;
 left:50%;
 width:25px;
 height:22px;
 background:#7b5700;
 border-radius:50%;
 transform:translateX(-50%)
}

/* MUTATION EMOJIS */

.mutationParticles{
 position:absolute;
 inset:0;
 pointer-events:none;
 z-index:20
}

.mutationParticle{
 position:absolute;
 animation:particleLife 1.5s ease-out forwards;
 filter:drop-shadow(0 3px 3px #0008)
}

@keyframes particleLife{
 0%{
  opacity:0;
  transform:scale(.2) rotate(-20deg)
 }
 15%{
  opacity:1
 }
 70%{
  opacity:1
 }
 100%{
  opacity:0;
  transform:translate(var(--dx),var(--dy)) scale(.8) rotate(20deg)
 }
}

.mutationDisplay{
 margin-top:12px;
 width:min(850px,96%);
 display:flex;
 justify-content:center;
 flex-wrap:wrap;
 gap:7px
}

.mutationTag{
 background:#101b23e8;
 border:1px solid #526878;
 border-radius:9px;
 padding:7px 9px;
 font-size:14px
}

.negative{
 border-color:#ff5555;
 color:#ff9a9a
}

.mutationCompanions{
 position:absolute;
 bottom:18px;
 left:0;
 right:0;
 display:flex;
 justify-content:center;
 gap:12px;
 pointer-events:none
}

.companion{
 font-size:48px;
 filter:drop-shadow(0 4px 4px #0007);
 animation:companionIn .35s ease-out
}

@keyframes companionIn{
 from{
  transform:scale(0) translateY(20px);
  opacity:0
 }
 to{
  transform:scale(1);
  opacity:1
 }
}

/* BUTTONS */

.buttons{
 display:flex;
 justify-content:center;
 flex-wrap:wrap;
 gap:10px;
 margin:18px 0
}

.mutate{
 background:#9b59b6;
 box-shadow:0 5px 0 #713d85
}

.sell{
 background:#f39c12;
 box-shadow:0 5px 0 #a96505
}

.shopBtn{
 background:#28a765;
 box-shadow:0 5px 0 #16713f
}

.oddsBtn{
 background:#3478db;
 box-shadow:0 5px 0 #225397
}

.indexBtn{
 background:#7751c7;
 box-shadow:0 5px 0 #4d3187
}

/* PANELS */

.panel{
 background:#15212b;
 border:1px solid #344858;
 border-radius:16px;
 padding:16px;
 margin-bottom:15px
}

.panel h2{
 margin-top:0
}

table{
 width:100%;
 border-collapse:collapse
}

th,td{
 padding:9px;
 border-bottom:1px solid #2d3c48;
 text-align:left
}

th{
 color:#ffd95a
}

/* MODALES */

.modal{
 position:fixed;
 inset:0;
 background:#000c;
 display:none;
 align-items:center;
 justify-content:center;
 z-index:100;
 padding:15px
}

.modalBox{
 width:min(760px,96%);
 max-height:90vh;
 overflow:auto;
 background:#17232d;
 border:1px solid #455b6b;
 border-radius:18px;
 padding:20px
}

.close{
 float:right;
 background:#34495e;
 padding:8px 12px
}

input{
 width:100%;
 padding:15px;
 border-radius:12px;
 border:2px solid #455967;
 background:#0d151c;
 color:white;
 font-size:18px;
 outline:none
}

.usernameScreen{
 position:fixed;
 inset:0;
 background:linear-gradient(160deg,#14212c,#070a0e);
 display:flex;
 justify-content:center;
 align-items:center;
 z-index:200
}

.usernameBox{
 width:min(430px,90%);
 text-align:center;
 background:#182631;
 padding:25px;
 border-radius:20px;
 border:1px solid #405363
}

.usernameBox button{
 margin-top:12px;
 background:#9b59b6
}

.secret{
 position:fixed;
 inset:0;
 display:none;
 justify-content:center;
 align-items:center;
 background:#000e;
 z-index:300;
 text-align:center
}

.secretText{
 font-size:clamp(38px,12vw,110px);
 font-weight:1000;
 animation:secret .3s infinite alternate
}

@keyframes secret{
 from{transform:scale(1) rotate(-2deg)}
 to{transform:scale(1.12) rotate(2deg)}
}

.explosion{
 position:fixed;
 inset:0;
 display:none;
 align-items:center;
 justify-content:center;
 z-index:250;
 pointer-events:none
}

.boom{
 width:30px;
 height:30px;
 border-radius:50%;
 background:white;
 box-shadow:
 0 0 30px 15px white,
 0 0 100px 50px #ffb300;
 animation:boom 1s ease-out forwards
}

@keyframes boom{
 0%{transform:scale(.1);opacity:1}
 40%{transform:scale(8);opacity:1}
 100%{transform:scale(30);opacity:0}
}

.log{
 max-height:170px;
 overflow:auto;
 color:#c4d0da;
 font-size:14px
}

.log div{
 padding:5px 0;
 border-bottom:1px solid #26343f
}

.mutationRow{
 display:flex;
 justify-content:space-between;
 padding:8px;
 border-bottom:1px solid #2d3b46
}

.unknown{
 color:#687783
}

.shopItem{
 background:#202f3a;
 border:1px solid #3b5262;
 border-radius:15px;
 padding:15px;
 margin:10px 0;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px
}

.shopBuy{
 background:#28a765;
 box-shadow:0 4px 0 #16713f
}

.shopBuy.disabled{
 background:#555;
 box-shadow:0 4px 0 #333;
 opacity:.6
}

.info{
 color:#84929e;
 font-size:13px;
 text-align:center;
 padding-bottom:25px
}

</style>
</head>

<body>

<div class="usernameScreen" id="usernameScreen">

<div class="usernameBox">

<h1>🍅 Tomato Mutations</h1>

<p>Choisis ton username</p>

<input
 id="usernameInput"
 maxlength="16"
 placeholder="Username">

<button id="startButton">
COMMENCER
</button>

</div>
</div>

<header>

<h1>🍅 Tomato Mutations</h1>

<div class="subtitle">
Joueur :
<strong id="usernameDisplay">---</strong>
</div>

</header>

<div class="stats">

<div class="stat">
💰<br>
<strong id="money">$0</strong>
</div>

<div class="stat">
🧬<br>
<strong id="mutationCount">0</strong>
</div>

<div class="stat">
🌱<br>
<strong id="generation">1</strong>
</div>

</div>

<main class="game">

<section class="field">

<div class="fruit" id="fruit">

<div class="stem"></div>
<div class="leaf"></div>
<div class="leaf r"></div>

<div class="faceEye left"></div>
<div class="faceEye right"></div>

<div class="cheek left"></div>
<div class="cheek right"></div>

<div class="mouth"></div>

<div id="bananaCostume"></div>

</div>

<div
class="mutationParticles"
id="mutationParticles">
</div>

<div
class="fruitName"
id="fruitName">
🍅 Tomate normale
</div>

<div
class="value"
id="fruitValue">
$10
</div>

<div
class="mutationDisplay"
id="mutationDisplay">
</div>

<div
class="mutationCompanions"
id="mutationCompanions">
</div>

</section>

<div class="buttons">

<button class="mutate" id="mutateButton">
🧬 MUTER
</button>

<button class="sell" id="sellButton">
💰 VENDRE
</button>

<button class="shopBtn" id="shopButton">
🛒 BOUTIQUE
</button>

<button class="indexBtn" id="indexButton">
📖 INDEX
</button>

<button class="oddsBtn" id="oddsButton">
🎲 ODDS
</button>

</div>

<section class="panel">

<h2>🏆 Mes records</h2>

<table>

<tr>
<th></th>
<th>Meilleur prix</th>
<th>Mutations</th>
</tr>

<tr>
<th>🍅 Tomate</th>
<td id="bestTomatoValue">$0</td>
<td id="bestTomatoMutations">Aucune</td>
</tr>

<tr>
<th>🥕 Carotte</th>
<td id="bestCarrotValue">$0</td>
<td id="bestCarrotMutations">Aucune</td>
</tr>

</table>

</section>

<section class="panel">

<h2>🌎 TOP 10</h2>

<table>

<thead>
<tr>
<th>#</th>
<th>Pseudo</th>
<th>🍅 Tomate</th>
<th>🥕 Carotte</th>
</tr>
</thead>

<tbody id="leaderboard"></tbody>

</table>

</section>

<section class="panel">

<h2>📜 Journal</h2>

<div class="log" id="log"></div>

</section>

<div class="info">
Chaque clic sur MUTER remplace complètement la combinaison précédente.
</div>

</main>


<!-- SHOP -->

<div class="modal" id="shopModal">

<div class="modalBox">

<button class="close"
onclick="closeModal('shopModal')">
✕
</button>

<h2>🛒 Boutique</h2>

<div class="shopItem">

<div>

<strong>🥕 Carotte</strong>

<br>

Prix :
<strong>100K</strong>

<br>

💵 <strong>×2</strong> valeur

<br>

<small id="carrotInfo">
Disponible uniquement avec une tomate normale.
</small>

</div>

<button
class="shopBuy"
id="carrotButton">
100K
</button>

</div>

</div>
</div>


<!-- ODDS -->

<div class="modal" id="oddsModal">

<div class="modalBox">

<button class="close"
onclick="closeModal('oddsModal')">
✕
</button>

<h2>🎲 ODDS</h2>

<p>
Les 3 mutations secrètes ne sont pas affichées.
</p>

<div id="oddsList"></div>

</div>
</div>


<!-- INDEX -->

<div class="modal" id="indexModal">

<div class="modalBox">

<button class="close"
onclick="closeModal('indexModal')">
✕
</button>

<h2>📖 Index des mutations</h2>

<div id="indexList"></div>

</div>
</div>


<div class="secret" id="secretScreen">

<div class="secretText" id="secretText"></div>

</div>


<div class="explosion" id="explosion">

<div class="boom"></div>

</div>


<script>

/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
"https://rjsrmwtbglhuarmqyfun.supabase.co";

const SUPABASE_KEY =
"sb_publishable_mSlW81Ge9VrJmFEk-nWGCQ_31yVwxEL";

const supabaseClient =
window.supabase.createClient(
 SUPABASE_URL,
 SUPABASE_KEY
);


/* =========================================================
   VERSION / RESET GLOBAL
========================================================= */

const UPDATE_VERSION="4.0";

const RESET_VERSION="4.0";

let resetDone =
localStorage.getItem("tomatoGlobalResetVersion");

async function globalReset(){

if(resetDone===RESET_VERSION)
return;

try{

const {data,error}=await supabaseClient
.from("leaderboard")
.select("id");

if(error) throw error;

if(data){

for(const row of data){

await supabaseClient
.from("leaderboard")
.update({
 best_tomato:0,
 best_carrot:0,
 tomato_mutations:[],
 carrot_mutations:[],
 updated_at:new Date().toISOString()
})
.eq("id",row.id);

}

}

localStorage.setItem(
"tomatoGlobalResetVersion",
RESET_VERSION
);

}catch(error){

console.error(
"Erreur reset Supabase:",
error
);

}

}

globalReset();


/* =========================================================
   RESET ARGENT LOCAL
========================================================= */

if(
localStorage.getItem("tomatoUpdateVersion")
!==UPDATE_VERSION
){

localStorage.setItem(
"tomatoMoney",
"0"
);

localStorage.setItem(
"tomatoUpdateVersion",
UPDATE_VERSION
);

}


/* =========================================================
   VARIABLES
========================================================= */

let username=
localStorage.getItem("tomatoUsername")||"";

let money=
Number(localStorage.getItem("tomatoMoney"))||0;

let generation=
Number(localStorage.getItem("tomatoGeneration"))||1;

let currentMutations=[];

let fruitType="tomato";


/* =========================================================
   RECORDS
========================================================= */

let bestTomatoValue=
Number(localStorage.getItem("bestTomatoValue"))||0;

let bestTomatoMutations=
JSON.parse(
localStorage.getItem("bestTomatoMutations")||"[]"
);

let bestCarrotValue=
Number(localStorage.getItem("bestCarrotValue"))||0;

let bestCarrotMutations=
JSON.parse(
localStorage.getItem("bestCarrotMutations")||"[]"
);

let discovered=
JSON.parse(
localStorage.getItem("discoveredMutations")||"[]"
);


/* =========================================================
   MUTATIONS
   MULTIPLICATEURS FORTEMENT RÉDUITS
========================================================= */

const M=[

["Dorée","🟡",1.10,1.00],
["Verte","🟢",1.08,.90],
["Géante","🔴",1.12,.80],
["Petite","🔵",1.06,.80],

["Banane","🍌",1.35,.70],
["Fraise","🍓",1.18,.65],
["Pastèque","🍉",1.22,.60],
["Citron","🍋",1.16,.60],
["Orange","🍊",1.20,.55],
["Raisin","🍇",1.25,.55],
["Cerise","🍒",1.28,.50],
["Pêche","🍑",1.26,.50],
["Ananas","🍍",1.32,.45],
["Kiwi","🥝",1.30,.45],
["Noix de coco","🥥",1.38,.40],

["Pomme","🍎",1.32,.40],
["Poire","🍐",1.34,.38],
["Mangue","🥭",1.40,.38],
["Myrtille","🫐",1.42,.35],
["Melon","🍈",1.38,.35],
["Grenade","🍎",1.45,.32],
["Carambole","⭐",1.50,.30],
["Fruit du dragon","🐉",1.55,.28],
["Litchi","🍒",1.58,.28],
["Papaye","🥭",1.60,.25],
["Avocat","🥑",1.62,.25],
["Aubergine","🍆",1.65,.22],
["Poivron","🫑",1.68,.22],
["Maïs","🌽",1.70,.20],

["Lapin","🐇",1.75,.20],
["Chat","🐱",1.80,.18],
["Chien","🐶",1.85,.18],
["Renard","🦊",1.90,.16],
["Loup","🐺",1.95,.16],
["Ours","🐻",2.00,.14],
["Panda","🐼",2.05,.14],
["Koala","🐨",2.10,.13],
["Singe","🐒",2.15,.13],
["Gorille","🦍",2.20,.12],
["Lion","🦁",2.25,.12],
["Tigre","🐯",2.30,.11],
["Éléphant","🐘",2.35,.11],
["Girafe","🦒",2.40,.10],
["Zèbre","🦓",2.45,.10],
["Poule","🐔",2.50,.09],
["Canard","🦆",2.55,.09],
["Pingouin","🐧",2.60,.08],
["Tortue","🐢",2.70,.08],
["Dragon","🐲",2.80,.07],

["Cristallisée","💎",2.30,.06],
["Électrique","⚡",2.40,.06],
["Enflammée","🔥",2.50,.055],
["Glacée","❄️",2.55,.055],
["Arc-en-ciel","🌈",2.70,.05],

["Pourris","☠️",.75,.50],
["Assèché","🏜️",.65,.30],

["Pluie","🌧️",1.12,.60],
["Orage","⛈️",1.30,.45],
["Foudre","⚡",1.45,.30],
["Neige","🌨️",1.25,.35],
["Blizzard","🌬️",1.55,.20],
["Brouillard","🌫️",1.14,.45],
["Vent","💨",1.10,.50],
["Tornade","🌪️",1.70,.15],
["Ouragan","🌀",1.85,.10],
["Canicule","☀️",1.28,.30],
["Éclipse","🌑",1.75,.09],
["Aurore","🌌",1.90,.08],
["Arc solaire","🌈",2.00,.07],
["Gravité","🪐",2.05,.065],
["Antigravité","🌀",2.10,.06],
["Onde de choc","💥",2.15,.055],
["Séisme","🌋",1.80,.07],
["Météorite","☄️",2.25,.052],
["Supernova","💫",2.35,.051],
["Trou noir","🕳️",2.50,.05],

["Cristaux de glace","🧊",1.65,.10],
["Rosée","💧",1.08,.55],
["Givre","🥶",1.25,.20],
["Sable","🏜️",1.12,.35],
["Tempête de sable","🌪️",1.40,.12],
["Lave","🌋",1.75,.08],
["Volcanique","🌋",1.95,.07],
["Plasma","🔮",2.15,.06],
["Radiation","☢️",2.30,.055],
["Magnétique","🧲",2.05,.052]

];


/* =========================================================
   NOUVELLES MUTATIONS
   ODDS BASSES
========================================================= */

const NEW_MUTATIONS=[

["🍏 Pomme dorée","🍏",1.55,.50],
["🍐 Poire géante","🍐",1.60,.45],
["🍊 Mandarine","🍊",1.45,.40],
["🍋 Citron givré","🍋",1.50,.35],
["🍉 Pastèque glacée","🍉",1.65,.30],
["🍇 Raisin cristal","🍇",1.70,.28],
["🍒 Cerise électrique","🍒",1.75,.25],
["🥭 Mangue solaire","🥭",1.80,.22],
["🥝 Kiwi radioactif","🥝",1.85,.20],
["🍍 Ananas royal","🍍",1.90,.18],
["🥥 Coco volcanique","🥥",1.95,.16],
["🫐 Myrtille cosmique","🫐",2.00,.14],
["🍈 Melon lunaire","🍈",2.05,.12],
["🥑 Avocat mutant","🥑",2.10,.10],
["🌽 Maïs géant","🌽",2.15,.09],

["🐸 Grenouille","🐸",1.50,.08],
["🦊 Renard polaire","🦊",1.65,.075],
["🐼 Panda rouge","🐼",1.70,.07],
["🦁 Lion solaire","🦁",1.80,.065],
["🐯 Tigre fantôme","🐯",1.85,.06],
["🐺 Loup lunaire","🐺",1.90,.055],
["🦅 Aigle","🦅",1.95,.052],
["🦉 Hibou","🦉",2.00,.05],
["🐍 Serpent","🐍",2.05,.048],
["🦎 Lézard","🦎",2.10,.046],
["🐙 Poulpe","🐙",2.15,.044],
["🦈 Requin","🦈",2.20,.042],
["🐳 Baleine","🐳",2.25,.040],
["🦋 Papillon","🦋",1.80,.038],
["🐝 Abeille","🐝",1.70,.036],

["🌸 Floraison","🌸",1.30,.034],
["🍄 Champignon","🍄",1.45,.032],
["🌴 Tropicale","🌴",1.50,.030],
["🌵 Cactus","🌵",1.55,.028],
["🌲 Forêt","🌲",1.60,.026],
["🌙 Lunaire","🌙",1.75,.024],
["☀️ Solaire","☀️",1.80,.022],
["⭐ Stellaire","⭐",1.90,.020],
["🪐 Galactique","🪐",2.00,.018],
["👽 Alien","👽",2.10,.016],
["👻 Fantôme","👻",2.20,.014],
["💀 Maudite","💀",2.30,.012],
["👑 Royale","👑",2.40,.010],
["💠 Diamant bleu","💠",2.50,.008],
["🔥 Inferno","🔥",2.60,.006],

["🧪 Expérimentale","🧪",2.70,.004],
["🧿 Mystique","🧿",2.80,.003],
["⚜️ Divine","⚜️",2.90,.002],
["🪽 Céleste","🪽",3.00,.001],
["🌟 ULTIME","🌟",3.20,.0005]

];


/* Ajout des nouvelles mutations */

for(const m of NEW_MUTATIONS){
 M.push(m);
}


/* =========================================================
   SECRETS
========================================================= */

const SECRETS=[

{
name:"Bober Turba",
emoji:"🦫",
multiplier:4,
denominator:10000
},

{
name:"FAAAAAAAAAAAH",
emoji:"📢",
multiplier:5,
denominator:50000
},

{
name:"Tortue Pingouin",
emoji:"🐢🐧",
multiplier:7,
denominator:100000
}

];


/* =========================================================
   ANIMAUX
========================================================= */

const animalNames=new Set([

"Lapin","Chat","Chien","Renard","Loup",
"Ours","Panda","Koala","Singe","Gorille",
"Lion","Tigre","Éléphant","Girafe","Zèbre",
"Poule","Canard","Pingouin","Tortue","Dragon"

]);


/* =========================================================
   FORMAT ARGENT
========================================================= */

function formatMoney(n){

n=Number(n);

if(n<1000)
return "$"+Math.floor(n);

const units=[
["K",1e3],
["M",1e6],
["B",1e9],
["T",1e12],
["Qa",1e15],
["Qi",1e18],
["Sx",1e21],
["Sp",1e24],
["Oc",1e27],
["No",1e30],
["Dc",1e33]
];

for(let i=units.length-1;i>=0;i--){

if(n>=units[i][1]){

let x=n/units[i][1];

return "$"+
(
x>=100 ? x.toFixed(0) :
x>=10 ? x.toFixed(1) :
x.toFixed(2)
)+units[i][0];

}

}

return "$"+n;

}


/* =========================================================
   MUTATION RANDOM
========================================================= */

function chooseMutation(){

const total=M.reduce(
(s,m)=>s+Number(m[3]),0
);

let r=Math.random()*total;

for(const m of M){

r-=Number(m[3]);

if(r<=0)
return m;

}

return M[0];

}


/* =========================================================
   NOMBRE DE MUTATIONS
========================================================= */

function getMutationAmount(){

const r=Math.random();

if(r<.95) return 1;
if(r<.98) return 2;
if(r<.992) return 3;
if(r<.997) return 4;
if(r<.999) return 5;
if(r<.9997) return Math.floor(Math.random()*5)+6;
if(r<.99995) return Math.floor(Math.random()*40)+11;
if(r<.999995) return Math.floor(Math.random()*50)+51;

return Math.floor(Math.random()*100)+101;

}


/* =========================================================
   VALEUR
========================================================= */

function calculateValue(){

let value=10;

for(const mutation of currentMutations){
 value*=mutation.multiplier;
}

if(fruitType==="carrot")
 value*=2;

return Math.max(0,value);

}


/* =========================================================
   SECRETS
========================================================= */

function checkSecrets(){

for(const secret of SECRETS){

if(
Math.floor(
Math.random()*secret.denominator
)===0
){

currentMutations.push({

name:secret.name,
emoji:secret.emoji,
multiplier:secret.multiplier,
secret:true

});

if(!discovered.includes(secret.name))
 discovered.push(secret.name);

if(secret.name==="FAAAAAAAAAAAH"){

showSecret("📢 FAAAAAAAAAAAAAH 📢");

}else{

addLog(
"🔐 SECRET : "+
secret.emoji+" "+secret.name
);

}

triggerRareExplosion();

}

}

localStorage.setItem(
"discoveredMutations",
JSON.stringify(discovered)
);

}


/* =========================================================
   PARTICULES EMOJIS
========================================================= */

function showMutationParticles(){

const container=
document.getElementById(
"mutationParticles"
);

container.innerHTML="";

if(!currentMutations.length)
return;

const shuffled=
[...currentMutations]
.sort(()=>Math.random()-.5);

const amount=
Math.min(
4,
Math.max(
3,
shuffled.length
)
);

for(let i=0;i<amount;i++){

const m=
shuffled[i%shuffled.length];

const p=
document.createElement("div");

p.className="mutationParticle";

p.textContent=m.emoji;

const positions=[
 [18,22,-25,-35],
 [76,25,28,-30],
 [20,70,-30,30],
 [80,68,30,35]
];

const pos=positions[i];

p.style.left=pos[0]+"%";
p.style.top=pos[1]+"%";

p.style.fontSize=
(25+Math.random()*28)+"px";

p.style.setProperty(
"--dx",
pos[2]+"px"
);

p.style.setProperty(
"--dy",
pos[3]+"px"
);

container.appendChild(p);

}

}


/* =========================================================
   MUTER
========================================================= */

function mutate(){

currentMutations=[];

const amount=
getMutationAmount();

for(let i=0;i<amount;i++){

const m=chooseMutation();

currentMutations.push({

name:m[0],
emoji:m[1],
multiplier:m[2],
negative:m[2]<1,
secret:false

});

if(!discovered.includes(m[0]))
 discovered.push(m[0]);

}

checkSecrets();

localStorage.setItem(
"discoveredMutations",
JSON.stringify(discovered)
);

showMutationParticles();

if(amount>=10){

addLog(
"🌟 COMBINAISON EXTRÊMEMENT RARE : "+
amount+" mutations !"
);

}

updateFruit();
updateUI();

addLog(
amount===1
?
"🧬 Nouvelle mutation : "+
currentMutations[0].emoji+" "+
currentMutations[0].name
:
"🔥 Nouvelle combinaison : "+
amount+" mutations !"
);

save();

}


/* =========================================================
   BANANE
========================================================= */

function updateBanana(){

const fruit=
document.getElementById("fruit");

const costume=
document.getElementById("bananaCostume");

const banana=
currentMutations.some(
m=>m.name==="Banane"
);

costume.innerHTML="";

fruit.classList.toggle(
"bananaCostume",
banana
);

if(!banana)
return;

costume.innerHTML=`

<div class="bananaTop"></div>

<div class="bananaPeel p1"></div>
<div class="bananaPeel p2"></div>
<div class="bananaPeel p3"></div>

`;

}


/* =========================================================
   AFFICHAGE FRUIT
========================================================= */

function updateFruit(){

const fruit=
document.getElementById("fruit");

fruit.className="fruit";

if(fruitType==="carrot")
 fruit.classList.add("carrot");

for(const m of currentMutations){

if(m.name==="Dorée")
 fruit.classList.add("golden");

if(m.name==="Verte")
 fruit.classList.add("green");

if(m.name==="Arc-en-ciel")
 fruit.classList.add("rainbow");

if(m.name==="Enflammée")
 fruit.classList.add("fire");

if(m.name==="Glacée")
 fruit.classList.add("ice");

if(m.name==="Pourris")
 fruit.classList.add("rotten");

}

updateBanana();


const companions=
document.getElementById(
"mutationCompanions"
);

companions.innerHTML="";

const shown=[];

for(const m of currentMutations){

if(
animalNames.has(m.name)&&
!shown.includes(m.name)
){

shown.push(m.name);

const c=
document.createElement("div");

c.className="companion";

c.textContent=m.emoji;

c.title=m.name;

companions.appendChild(c);

}

}

}


/* =========================================================
   UI
========================================================= */

function updateUI(){

document.getElementById("money")
.textContent=formatMoney(money);

document.getElementById("generation")
.textContent=generation;

document.getElementById("mutationCount")
.textContent=currentMutations.length;

document.getElementById("fruitValue")
.textContent=formatMoney(
calculateValue()
);

document.getElementById("fruitName")
.textContent=
fruitType==="carrot"
?
"🥕 Carotte 💵 ×2"
:
currentMutations.length
?
"🍅 Tomate mutée"
:
"🍅 Tomate normale";


const display=
document.getElementById(
"mutationDisplay"
);

display.innerHTML="";

for(const m of currentMutations){

const tag=
document.createElement("div");

tag.className=
"mutationTag"+
(m.negative?" negative":"");

tag.textContent=
m.negative
?
m.emoji+" "+m.name+
" ÷"+Math.round(1/m.multiplier)
:
m.emoji+" "+m.name+
" ×"+m.multiplier;

display.appendChild(tag);

}

updateFruit();
updateRecords();
updateLeaderboard();

updateCarrotButton();

}


/* =========================================================
   CAROTTE : BOUTON BLOQUÉ SI MUTATION
========================================================= */

function updateCarrotButton(){

const button=
document.getElementById(
"carrotButton"
);

const info=
document.getElementById(
"carrotInfo"
);

const blocked=
currentMutations.length>0;

button.disabled=blocked;

button.classList.toggle(
"disabled",
blocked
);

if(blocked){

info.textContent=
"❌ Impossible : ta tomate possède une mutation.";

}else{

info.textContent=
"Disponible uniquement avec une tomate normale.";

}

}


/* =========================================================
   RECORDS
========================================================= */

function updateRecords(){

document.getElementById(
"bestTomatoValue"
).textContent=
formatMoney(bestTomatoValue);

document.getElementById(
"bestCarrotValue"
).textContent=
formatMoney(bestCarrotValue);

document.getElementById(
"bestTomatoMutations"
).innerHTML=
bestTomatoMutations.length
?
bestTomatoMutations.map(
m=>m.emoji+" "+m.name+" ×"+m.multiplier
).join("<br>")
:
"Aucune";

document.getElementById(
"bestCarrotMutations"
).innerHTML=
bestCarrotMutations.length
?
bestCarrotMutations.map(
m=>m.emoji+" "+m.name+" ×"+m.multiplier
).join("<br>")
:
"Aucune";

}


/* =========================================================
   RECORD APRÈS VENTE
========================================================= */

async function checkBestAfterSale(
value,
soldFruit,
mutations
){

if(
soldFruit==="tomato"&&
value>bestTomatoValue
){

bestTomatoValue=value;
bestTomatoMutations=mutations;

localStorage.setItem(
"bestTomatoValue",
value
);

localStorage.setItem(
"bestTomatoMutations",
JSON.stringify(mutations)
);

addLog(
"🏆 NOUVEAU RECORD TOMATE : "+
formatMoney(value)
);

await saveOnline();

}


if(
soldFruit==="carrot"&&
value>bestCarrotValue
){

bestCarrotValue=value;
bestCarrotMutations=mutations;

localStorage.setItem(
"bestCarrotValue",
value
);

localStorage.setItem(
"bestCarrotMutations",
JSON.stringify(mutations)
);

addLog(
"🏆 NOUVEAU RECORD CAROTTE : "+
formatMoney(value)
);

await saveOnline();

}

}


/* =========================================================
   VENDRE
========================================================= */

async function sell(){

if(!currentMutations.length){

addLog(
"❌ Il faut au moins une mutation pour vendre."
);

return;

}

const value=calculateValue();

const soldFruit=fruitType;

const soldMutations=
currentMutations.map(m=>({

name:m.name,
emoji:m.emoji,
multiplier:m.multiplier

}));

await checkBestAfterSale(
value,
soldFruit,
soldMutations
);

money+=value;

addLog(
"💰 Vente : +"+formatMoney(value)
);

currentMutations=[];

fruitType="tomato";

generation++;

save();

await saveOnline();

updateUI();

}


/* =========================================================
   ACHETER CAROTTE
========================================================= */

async function buyCarrot(){

if(currentMutations.length>0){

addLog(
"❌ Impossible d'acheter une carotte avec une tomate mutée."
);

return;

}

if(money<100000){

addLog("❌ Il faut 100K.");

return;

}

money-=100000;

fruitType="carrot";

addLog(
"🥕 Carotte achetée ! Elle vaut ×2."
);

updateUI();

save();

closeModal("shopModal");

}


/* =========================================================
   LOCAL SAVE
========================================================= */

function save(){

localStorage.setItem(
"tomatoMoney",
money
);

localStorage.setItem(
"tomatoGeneration",
generation
);

}


/* =========================================================
   SUPABASE : SAUVEGARDE ONLINE
========================================================= */

async function saveOnline(){

if(!username)
return;

try{

const payload={

username:username,

best_tomato:bestTomatoValue,

best_carrot:bestCarrotValue,

tomato_mutations:
bestTomatoMutations,

carrot_mutations:
bestCarrotMutations,

updated_at:
new Date().toISOString()

};

const {error}=await supabaseClient
.from("leaderboard")
.upsert(
payload,
{
onConflict:"username"
}
);

if(error)
console.error(
"Supabase save:",
error
);

}catch(error){

console.error(error);

}

}


/* =========================================================
   LEADERBOARD ONLINE
========================================================= */

async function updateLeaderboard(){

const tbody=
document.getElementById(
"leaderboard"
);

try{

const {data,error}=
await supabaseClient
.from("leaderboard")
.select(
"username,best_tomato,best_carrot"
)
.order(
"best_tomato",
{ascending:false}
)
.limit(10);

if(error) throw error;

tbody.innerHTML="";

(data||[]).forEach((p,i)=>{

const tr=
document.createElement("tr");

tr.innerHTML=`

<td>${i+1}</td>

<td>
${escapeHTML(p.username)}
</td>

<td>
${formatMoney(p.best_tomato||0)}
</td>

<td>
${formatMoney(p.best_carrot||0)}
</td>

`;

tbody.appendChild(tr);

});

}catch(error){

console.error(
"Leaderboard:",
error
);

tbody.innerHTML=`

<tr>
<td colspan="4">
Impossible de charger le classement.
</td>
</tr>

`;

}

}


/* =========================================================
   SECRET SCREEN
========================================================= */

function showSecret(text){

const screen=
document.getElementById(
"secretScreen"
);

document.getElementById(
"secretText"
).textContent=text;

screen.style.display="flex";

setTimeout(
()=>{
screen.style.display="none";
},
4000
);

}


/* =========================================================
   EXPLOSION
========================================================= */

function triggerRareExplosion(){

const explosion=
document.getElementById(
"explosion"
);

explosion.style.display="flex";

setTimeout(
()=>{
explosion.style.display="none";
},
1000
);

}


/* =========================================================
   JOURNAL
========================================================= */

function addLog(message){

const log=
document.getElementById("log");

const div=
document.createElement("div");

div.textContent="• "+message;

log.prepend(div);

while(log.children.length>50)
 log.removeChild(log.lastChild);

}


/* =========================================================
   INDEX
========================================================= */

function openIndex(){

const list=
document.getElementById(
"indexList"
);

list.innerHTML="";

const all=
M.map(m=>({

name:m[0],
emoji:m[1],
multiplier:m[2],
secret:false

})).concat(

SECRETS.map(s=>({

name:s.name,
emoji:s.emoji,
multiplier:s.multiplier,
secret:true

}))

);

for(const m of all){

const row=
document.createElement("div");

row.className="mutationRow";

if(discovered.includes(m.name)){

row.innerHTML=`

<span>
${m.emoji} ${m.name}
</span>

<strong>
×${m.multiplier}
</strong>

`;

}else{

row.innerHTML=`

<span class="unknown">
❓ Mutation inconnue
</span>

<span>???</span>

`;

}

list.appendChild(row);

}

document.getElementById(
"indexModal"
).style.display="flex";

}


/* =========================================================
   ODDS
========================================================= */

function openOdds(){

const list=
document.getElementById(
"oddsList"
);

list.innerHTML="";

const total=
M.reduce(
(s,m)=>s+Number(m[3]),0
);

for(const m of M){

const probability=
Number(m[3])/total*100;

const row=
document.createElement("div");

row.className="mutationRow";

row.innerHTML=`

<span>
${m[1]} ${m[0]}
</span>

<strong>
${
probability<0.05
?
"<0,05%"
:
probability.toFixed(2)+"%"
}
</strong>

`;

list.appendChild(row);

}

document.getElementById(
"oddsModal"
).style.display="flex";

}


/* =========================================================
   MODALES
========================================================= */

function closeModal(id){

document.getElementById(id)
.style.display="none";

}


/* =========================================================
   USERNAME
========================================================= */

async function buyOrStart(){

const input=
document.getElementById(
"usernameInput"
);

const name=
input.value.trim();

if(name.length<2){

alert(
"Choisis un username d'au moins 2 caractères."
);

return;

}

username=
name.substring(0,16);

localStorage.setItem(
"tomatoUsername",
username
);

document.getElementById(
"usernameScreen"
).style.display="none";

document.getElementById(
"usernameDisplay"
).textContent=username;

updateUI();

addLog(
"👋 Bienvenue "+username+" !"
);

await saveOnline();

await updateLeaderboard();

}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(text){

const d=
document.createElement("div");

d.textContent=text;

return d.innerHTML;

}


/* =========================================================
   EVENTS
========================================================= */

document
.getElementById("startButton")
.addEventListener(
"click",
buyOrStart
);

document
.getElementById("usernameInput")
.addEventListener(
"keydown",
e=>{

if(e.key==="Enter")
buyOrStart();

}
);

document
.getElementById("mutateButton")
.addEventListener(
"click",
mutate
);

document
.getElementById("sellButton")
.addEventListener(
"click",
sell
);

document
.getElementById("shopButton")
.addEventListener(
"click",
()=>{

document.getElementById(
"shopModal"
).style.display="flex";

updateCarrotButton();

}
);

document
.getElementById("indexButton")
.addEventListener(
"click",
openIndex
);

document
.getElementById("oddsButton")
.addEventListener(
"click",
openOdds
);

document
.getElementById("carrotButton")
.addEventListener(
"click",
buyCarrot
);


/* =========================================================
   DÉMARRAGE
========================================================= */

if(username){

document.getElementById(
"usernameScreen"
).style.display="none";

document.getElementById(
"usernameDisplay"
).textContent=username;

}else{

document.getElementById(
"usernameScreen"
).style.display="flex";

}

updateFruit();

updateUI();

addLog(
"🍅 Bienvenue dans Tomato Mutations !"
);

</script>

</body>
</html>
